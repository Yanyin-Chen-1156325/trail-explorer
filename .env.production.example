# Azure App Service backend settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__Postgres=Host=your-supabase-host;Port=5432;Database=postgres;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

Cors__AllowedOrigins__0=https://trail-explorer-drab.vercel.app

DocApi__ApiKey=
DocApi__BaseUrl=https://api.doc.govt.nz

GoogleOAuth__ClientId=your-google-oauth-client-id.apps.googleusercontent.com

Jwt__AccessTokenExpirationMinutes=15
Jwt__Audience=TrailExplorerAPI
Jwt__Issuer=TrailExplorer
Jwt__RefreshTokenExpirationDays=7
Jwt__Secret=replace-with-a-production-length-secret-at-least-32-characters

OpenApi__Enabled=true

TrailSynchronisation__Enabled=false
TrailSynchronisation__IntervalHours=24
TrailSynchronisation__RunOnStartup=false

WEBSITES_CONTAINER_START_TIME_LIMIT=600
WEBSITES_ENABLE_APP_SERVICE_STORAGE=false
WEBSITES_PORT=8080

# Vercel frontend settings
VITE_API_BASE_URL=https://your-azure-backend-domain/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
