SUPABASE_POSTGRES_CONNECTION_STRING=Host=your-supabase-host;Port=5432;Database=postgres;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
JWT_SECRET=replace-with-a-production-length-secret-at-least-32-characters
JWT_ISSUER=TrailExplorer
JWT_AUDIENCE=TrailExplorerAPI
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FRONTEND_ALLOWED_ORIGIN=https://your-frontend-domain.example
VITE_API_BASE_URL=https://your-backend-domain.example/api
DOC_API_BASE_URL=https://api.doc.govt.nz
DOC_API_KEY=
TRAIL_SYNC_ENABLED=false
TRAIL_SYNC_RUN_ON_STARTUP=false
TRAIL_SYNC_INTERVAL_HOURS=24
